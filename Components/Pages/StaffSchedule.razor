@inject PetShop.Services.StaffActionFeedback Feedback
@page "/system/schedule"
@layout PetShop_PRN222.Components.Layout.StaffWorkspaceLayout
@rendermode InteractiveServer
@using PetShop.Models
@using PetShop.Services
@inject IStaffDashboardService DashboardService
@inject IStaffProfileService ProfileService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Lịch Làm Việc - Nhân viên</PageTitle>
<PetShop_PRN222.Components.Staff.ShiftSwapPanel />

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Lịch Trực Cá Nhân</h3>
    <p class="text-muted">Danh sách các ca trực của bạn</p>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger rounded-4 fw-bold"><i class="fas fa-exclamation-circle me-2"></i> @errorMessage</div>
}

@if (schedules == null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (schedules.Count == 0)
{
    <div class="fox-card p-5 text-center shadow-sm border-0">
        <i class="fas fa-calendar-xmark fa-3x text-muted mb-3"></i>
        <p class="fw-bold text-muted mb-0">Bạn chưa được xếp ca nào. Liên hệ quản lý để được phân công.</p>
    </div>
}
else
{
    <div class="fox-card p-0 overflow-hidden shadow-sm border-0">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-4 text-start ps-5">Ngày / Ca</th>
                    <th class="py-4">Giờ Bắt Đầu</th>
                    <th class="py-4">Giờ Kết Thúc</th>
                    <th class="py-4">Trạng Thái</th>
                    <th class="py-4 pe-4">Chấm Công</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in schedules)
                {
                    var isCheckedIn = IsCheckedIn(s);
                    var isLate = !isCheckedIn && TimeSpan.TryParse(s.EndTime, out var endTime) && DateTime.Now >= s.WorkDate.Date.Add(endTime);
                    var checkInError = TimeSpan.TryParse(s.EndTime, out var end) ? StaffCheckInPolicy.Validate(s.WorkDate, s.WorkDate.Date.Add(end), DateTime.Now) : "Giờ ca không hợp lệ.";
                    <tr>
                        <td class="text-start ps-5 py-4">
                            <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill shadow-sm">@s.ShiftName</span>
                            <div class="text-muted mt-2 fw-bold">@s.WorkDate.ToString("dd/MM/yyyy")</div>
                            @if (!string.IsNullOrWhiteSpace(s.Note))
                            {
                                <div class="text-muted small mt-1">@s.Note</div>
                            }
                        </td>
                        <td class="fw-bold text-dark fs-4">@s.StartTime</td>
                        <td class="fw-bold text-secondary fs-4">@s.EndTime</td>
                        <td>
                            @if (isCheckedIn)
                            {
                                <span class="badge bg-success px-4 py-2 fs-6 rounded-pill shadow-sm"><i class="fas fa-check me-1"></i> Đã Check-in</span>
                            }
                            else if (isLate)
                            {
                                <span class="badge bg-danger px-4 py-2 fs-6 rounded-pill shadow-sm"><i class="fas fa-triangle-exclamation me-1"></i> Quá giờ check-in</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-4 py-2 fs-6 rounded-pill shadow-sm">@s.Status</span>
                            }
                        </td>
                        <td class="pe-4">
                            @if (!isCheckedIn)
                            {
                                <button class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow" @onclick="() => PerformCheckIn(s.ScheduleId)" disabled="@(isCheckingIn || checkInError is not null)" title="@checkInError">
                                    @if (isCheckingIn)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang check-in...</span>
                                    }
                                    else
                                    {
                                        <span>BẤM CHECK-IN</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-lg btn-light rounded-pill px-4 fw-bold text-success border border-success shadow-sm" disabled><i class="fas fa-check"></i> Hoàn tất</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StaffScheduleDto>? schedules;
    private string errorMessage = string.Empty;
    private bool isCheckingIn;
    private System.Threading.Timer? clock;
    public void Dispose() => clock?.Dispose();

    protected override async Task OnInitializedAsync()
    {
        clock = new System.Threading.Timer(_ => { _ = InvokeAsync(StateHasChanged); }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        await UserSession.LoadAsync();
        var user = UserSession.CurrentUser;
        if (user is null)
        {
            errorMessage = "Chưa đăng nhập. Vui lòng đăng nhập lại.";
            schedules = new List<StaffScheduleDto>();
            return;
        }

        schedules = await DashboardService.GetStaffSchedulesAsync(
            await ProfileService.ResolveStaffIdAsync(user.UserId, user.Email));
    }

    private static bool IsCheckedIn(StaffScheduleDto schedule)
    {
        // Cột varchar cũ lưu chữ Đ thành Ð trên một số collation SQL Server.
        return string.Equals(schedule.Status.Replace('Ð', 'Đ').Trim(), "Đã Check-in", StringComparison.OrdinalIgnoreCase)
            || string.Equals(schedule.Status, "CheckedIn", StringComparison.OrdinalIgnoreCase);
    }

    private async Task PerformCheckIn(int scheduleId)
    {
        if (isCheckingIn)
        {
            return;
        }

        isCheckingIn = true;
        errorMessage = string.Empty;

        try
        {
            var ok = await Feedback.RunAsync(() => DashboardService.CheckInAsync(scheduleId), "Check-in thành công.");
            if (!ok)
            {
                errorMessage = "Không check-in được. Vui lòng thử lại.";
                return;
            }

            var user = UserSession.CurrentUser;
            if (user is not null)
            {
                var staffId = await ProfileService.ResolveStaffIdAsync(user.UserId, user.Email);
                schedules = await DashboardService.GetStaffSchedulesAsync(staffId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi check-in: {ex.Message}";
        }
        finally
        {
            isCheckingIn = false;
        }
    }
}
