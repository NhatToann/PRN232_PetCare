@page "/system"
@layout PetShop_PRN222.Components.Layout.StaffWorkspaceLayout
@rendermode InteractiveServer
@using PetShop.Models
@using PetShop.Services
@inject IStaffReportsService ReportsService
@inject IProductManagementService ProductsService
@inject UserSessionService Session
@inject PetShop.Services.StaffRefreshSignal RefreshSignal
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<StaffDashboard> Logger
@implements IDisposable
<PageTitle>Tổng quan cửa hàng · PET STAFF</PageTitle>
<link rel="stylesheet" href="css/staff-dashboard.css" />
<div class="pet-dashboard">
<section class="welcome-panel">
 <div><span class="eyebrow">MỘT NGÀY CHĂM SÓC THẬT TỐT</span><h1>@(DateTime.Now.Hour < 12 ? "Chào buổi sáng" : DateTime.Now.Hour < 18 ? "Chào buổi chiều" : "Chào buổi tối"), @(Session.CurrentUser?.Name ?? "bạn")!</h1><p>Cùng xem tình hình hoạt động của cửa hàng hôm nay.</p><div class="welcome-actions"><a href="/system/bookings">Lịch hẹn Spa <i class="fas fa-arrow-right"></i></a><a href="/system/orders">Xử lý đơn hàng</a></div></div>
 <div class="welcome-date"><i class="fas fa-paw"></i><span>@DateTime.Now.ToString("dd/MM/yyyy")</span><small>Chăm chút từng người bạn nhỏ</small></div>
</section>
@if (isLoading) { <div class="dashboard-empty" role="status"><div class="spinner-border"></div><p>Đang tải tình hình cửa hàng…</p></div> }
else if (!string.IsNullOrEmpty(loadError)) { <div class="alert alert-danger" role="alert">@loadError <button class="btn btn-sm btn-outline-danger" @onclick="LoadDashboardAsync">Thử lại</button></div> }
else {
<div class="kpi-grid">
 @foreach (var k in new[] { ("Doanh thu hôm nay", PetShop.Components.Shared.Format.Vnd(revToday), "fa-wallet", "/revenue"), ("Doanh thu tuần này", PetShop.Components.Shared.Format.Vnd(revWeek), "fa-chart-line", "/revenue"), ("Đơn hàng cần xử lý", pendingOrders.ToString(), "fa-box-open", "/system/orders"), ("Lịch Spa hôm nay", todaySpaCount.ToString(), "fa-bath", "/system/bookings"), ("Sản phẩm sắp hết", lowStockCount.ToString(), "fa-boxes-stacked", "/products/inventory"), ("Tổng khách hàng", totalCustomers.ToString(), "fa-users", "") }) {
 <article class="metric-card"><div class="metric-heading"><span>@k.Item1</span><i class="fas @k.Item3"></i></div><strong>@k.Item2</strong>@if(k.Item4.Length>0){<a href="@k.Item4">Xem chi tiết <span>↗</span></a>}else{<small>Khách hàng trong hệ thống</small>}</article>
 }
</div>
<div class="work-grid">
<section class="dashboard-panel"><div class="panel-heading"><div><span class="eyebrow">CHĂM SÓC THÚ CƯNG</span><h2>Lịch Spa sắp tới</h2></div><a href="/system/bookings">Xem tất cả ↗</a></div>
@if(nextTasks.Count==0){<div class="dashboard-empty"><i class="fas fa-paw"></i><h3>Chưa có lịch hẹn sắp tới</h3><p>Lịch mới sẽ xuất hiện tại đây khi khách đặt dịch vụ.</p></div>}
@foreach(var t in nextTasks){<div class="task-row"><time>@t.Time</time><div><strong>@t.CustomerName</strong><p>@t.PetName · @t.PetBreed</p><small>@t.ServiceName</small></div><span class="soft-status">@t.Status</span></div>}
</section>
<section class="dashboard-panel"><div class="panel-heading"><div><span class="eyebrow">CÔNG VIỆC ƯU TIÊN</span><h2>Đơn hàng cần xử lý</h2></div><a href="/system/orders">Xem tất cả ↗</a></div>
@if(pendingList.Count==0){<div class="dashboard-empty"><i class="fas fa-box-open"></i><h3>Đã xử lý hết đơn hàng</h3><p>Không có đơn hàng đang chờ xử lý.</p></div>}
@foreach(var o in pendingList){<a class="order-row" href="/system/orders"><div><strong>#@o.OrderId</strong><p>@o.CustomerName</p><small>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</small></div><div><strong>@PetShop.Components.Shared.Format.Vnd(o.TotalAmount)</strong><p><span class="soft-status">@o.Status</span></p></div></a>}
</section></div>
<div class="analytics-grid"><section class="dashboard-panel"><div class="panel-heading"><div><span class="eyebrow">HIỆU QUẢ KINH DOANH</span><h2>Doanh thu 7 ngày</h2></div><a href="/revenue">Báo cáo ↗</a></div><div class="chart-frame"><canvas id="dashboardLineChart" aria-label="Biểu đồ doanh thu 7 ngày" role="img"></canvas></div></section><section class="dashboard-panel"><div class="panel-heading"><div><span class="eyebrow">TỔNG QUAN ĐƠN HÀNG</span><h2>Tỷ trọng trạng thái</h2></div></div>@if(completedOrders+pendingOrders+cancelledOrders==0){<div class="dashboard-empty">Chưa có dữ liệu đơn hàng.</div>}<div class="chart-frame"><canvas id="dashboardDonutChart" aria-label="Tỷ trọng trạng thái đơn hàng" role="img"></canvas></div><div class="chart-legend"><span>● Hoàn thành @completedOrders</span><span>● Cần xử lý @pendingOrders</span><span>● Đã hủy @cancelledOrders</span></div></section></div>
<section class="dashboard-panel stock-panel"><div class="panel-heading"><div><span class="eyebrow">CHÚ Ý TỒN KHO</span><h2>Sản phẩm sắp hết hàng</h2></div><a href="/products/inventory">Quản lý kho ↗</a></div>@if(stockList.Count==0){<p class="stock-empty">Tồn kho đang ổn định. Không có sản phẩm nào dưới ngưỡng 5.</p>}<div class="stock-grid">@foreach(var p in stockList){<a href="/products/inventory" class="stock-item"><span class="stock-icon"><i class="fas fa-box"></i></span><div><strong>@p.Name</strong><small>Còn @p.StockQuantity sản phẩm</small></div></a>}</div></section>
}
</div>

@code {
    private IJSObjectReference? chartModule;
    private bool isLoading = true;
    private string loadError = string.Empty;
    private List<StaffOrderListItemDto> pendingList = new();
    private List<Product> stockList = new();
    private decimal revToday = 0; private decimal revWeek = 0;
    private int pendingOrders = 0; private int todaySpaCount = 0;
    private int lowStockCount = 0; private int totalCustomers = 0;

    private List<string> lineLabels = new();
    private List<decimal> lineData = new();
    private int completedOrders = 0; private int cancelledOrders = 0;

    public class LocalTaskDto { public string Time { get; set; } = ""; public string CustomerName { get; set; } = ""; public string PetName { get; set; } = ""; public string PetBreed { get; set; } = ""; public string ServiceName { get; set; } = ""; public string Status { get; set; } = ""; }
    private List<LocalTaskDto> nextTasks = new();

    private IDisposable? _refreshSubscription;

    protected override async Task OnInitializedAsync()
    {
        // Nhận tín hiệu làm mới từ thanh trên (đồng hồ "Làm mới: 30s") để số liệu
        // trên dashboard luôn là dữ liệu MỚI NHẤT từ DB.
        _refreshSubscription = RefreshSignal.Subscribe(async () =>
        {
            await LoadDashboardAsync();
            await InvokeAsync(StateHasChanged);
        });

        await LoadDashboardAsync();
    }

    /// <summary>Nạp lại toàn bộ chỉ số + danh sách nhiệm vụ từ DB.</summary>
    private async Task LoadDashboardAsync()
    {
        try
        {
        loadError = string.Empty;
        pendingList = (await ReportsService.GetOrderListAsync(1000)).Where(o => o.Status is "Chờ xác nhận" or "Đang đóng gói" or "Đang giao hàng" or "Chờ giao hàng").Take(5).ToList();
        stockList = (await ProductsService.GetActiveProductsAsync()).Where(p => p.StockQuantity <= 5).OrderBy(p => p.StockQuantity).Take(5).ToList();
        // Chỉ số bảng điều khiển được tổng hợp ở tầng service (đơn hàng + spa).
        var metrics = await ReportsService.GetDashboardMetricsAsync();

        revToday = metrics.RevenueToday; revWeek = metrics.RevenueWeek;
        pendingOrders = metrics.PendingOrders;
        completedOrders = metrics.CompletedOrders; cancelledOrders = metrics.CancelledOrders;
        todaySpaCount = metrics.TodaySpaCount;
        lowStockCount = metrics.LowStockCount;
        totalCustomers = metrics.TotalCustomers;
        lineLabels = metrics.LineLabels;
        lineData = metrics.LineData;

        // "NHIỆM VỤ SPA TIẾP THEO": lấy lịch hẹn THẬT từ DB (đơn hàng đang chờ/xử lý),
        // sắp xếp theo thời gian tăng dần. KHÔNG hardcode tên khách/giờ như trước —
        // dữ liệu giả làm dashboard hiển thị sai và dễ gây hiểu lầm khi chấm bài.
        var bookings = await ReportsService.GetBookingListAsync();
        var now = DateTime.Now;
        nextTasks = bookings
            .Where(b => b.Status is "Chờ xác nhận" or "Chưa thanh toán" or "Đang tiến hành" or "Đang xử lý")
            .Where(b => b.AppointmentStart >= now.AddHours(-2))
            .OrderBy(b => b.AppointmentStart)
            .Take(6)
            .Select(b => new LocalTaskDto
            {
                Time = b.AppointmentStart.ToString("HH:mm · dd/MM"),
                CustomerName = string.IsNullOrWhiteSpace(b.CustomerName) ? "Khách hàng" : b.CustomerName,
                PetName = string.IsNullOrWhiteSpace(b.PetName) ? "Thú cưng" : b.PetName,
                PetBreed = string.IsNullOrWhiteSpace(b.PetBreed) ? "—" : b.PetBreed,
                ServiceName = string.IsNullOrWhiteSpace(b.ServiceName) ? "Dịch vụ Spa" : b.ServiceName,
                Status = b.Status
            })
            .ToList();

        }
        catch (Exception ex) { Logger.LogError(ex, "Không tải được bảng điều khiển."); loadError = "Không tải được dữ liệu. Vui lòng thử lại."; }
        finally { isLoading = false; }
    }

    public void Dispose()
    {
        _refreshSubscription?.Dispose();
        _refreshSubscription = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && string.IsNullOrEmpty(loadError))
        {
            var dLabels = new[] { "Hoàn Thành", "Cần Xử Lý", "Đã Hủy" };
            var dData = new[] { completedOrders, pendingOrders, cancelledOrders };
            var dColors = new[] { "#398675", "#F3A66B", "#b8c5bd" };
            chartModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/staffDashboard.js");
            await chartModule.InvokeVoidAsync("renderDashboardCharts", lineLabels.ToArray(), lineData.ToArray(), dLabels, dData, dColors);
        }
    }
}