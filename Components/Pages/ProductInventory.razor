@inject PetShop.Services.StaffActionFeedback Feedback
@page "/products/inventory"
@layout PetShop_PRN222.Components.Layout.StaffWorkspaceLayout
@rendermode InteractiveServer
@using PetShop.Services
@inject IProductManagementService ProductService

<PageTitle>Quản Lý Tồn Kho</PageTitle>
<link rel="stylesheet" href="css/staff-dashboard.css" />

<div class="pet-page-heading row mb-4">
    <div class="col-12">
        <span class="eyebrow">CỬA HÀNG & KHO</span><h2 class="fw-bold mb-1 text-dark">Quản Lý Tồn Kho</h2><p class="text-muted">Theo dõi số lượng và bổ sung hàng hóa cho cửa hàng.</p>
    </div>
</div>

<div class="inventory-overview"><div><i class="fas fa-boxes-stacked"></i><span>Sản phẩm đang quản lý</span><strong>@(inventoryList?.Count ?? 0)</strong></div><div><i class="fas fa-layer-group"></i><span>Tổng số lượng tồn</span><strong>@(inventoryList?.Sum(i => i.StockQuantity) ?? 0)</strong></div><div><i class="fas fa-triangle-exclamation"></i><span>Cần bổ sung (≤ 5)</span><strong>@(inventoryList?.Count(i => i.StockQuantity <= 5) ?? 0)</strong></div></div>
<div class="management-toolbar"><div><span class="eyebrow">KIỂM SOÁT HÀNG HÓA</span><h5>Chi tiết tồn kho</h5></div><input class="form-control" style="max-width:320px" placeholder="Tìm sản phẩm…" @bind="inventoryQuery" @bind:event="oninput" /></div>
<div class="fox-card p-0 overflow-hidden shadow-sm border-0 management-table">
    @if (inventoryList == null)
    {
        <div class="text-center py-5"><div class="spinner-border"></div></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table fox-table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 text-start ps-4">Sản Phẩm & SKU</th>
                        <th>SL Tồn Kho</th>

                        <th>Trạng Thái</th>
                        <th class="pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in inventoryList.Where(i => string.IsNullOrWhiteSpace(inventoryQuery) || i.Name.Contains(inventoryQuery, StringComparison.OrdinalIgnoreCase)))
                    {
                        <tr>
                            <td class="text-start ps-4 py-3 d-flex align-items-center gap-3">
                                <img src="@PetShop.Components.Shared.ImageUrl.Safe(item.ImageUrl)" class="rounded-3 shadow-sm border" style="width: 50px; height: 50px; object-fit: cover;" loading="lazy" decoding="async" />
                                <div>
                                    <div class="fw-bold text-dark">@item.Name</div><small class="text-muted">SKU #PRD-@item.ProductId.ToString("D4")</small>
                                </div>
                            </td>
                            <td><h4 class="fw-bold mb-0 text-primary">@item.StockQuantity</h4></td>

                            <td>
                                @if (item.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">Hết Hàng</span>
                                }
                                else
                                {

                                    <span class="badge bg-success px-3 py-2 rounded-pill">Còn Hàng</span>
                                }
                            </td>
                            <td class="pe-4">
                                <button class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3 shadow-sm" @onclick="() => OpenAdjustModal(item)">
                                    <i class="fas fa-boxes me-1"></i> Nhập kho
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (selectedProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header text-white p-4" style="background-color: #6c5ce7;">
                    <h5 class="fw-bold mb-0">Nhập kho: @selectedProduct.Name</h5>
                    <button class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="fw-bold mb-2">Nhập thêm số lượng</label>
                    <input type="number" min="1" step="1" class="form-control form-control-lg mb-3" @bind="addQuantity" @bind:event="oninput" disabled="@savingStock" />
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-secondary px-4 fw-bold rounded-pill" @onclick="CloseModal">Hủy</button>
                    <button class="btn btn-primary px-4 fw-bold rounded-pill shadow-sm" style="background-color: #6c5ce7; border:none;" @onclick="SaveStock" disabled="@savingStock">@(savingStock ? "Đang lưu…" : "Lưu")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string inventoryQuery = string.Empty;
    public class InventoryItem { public int ProductId { get; set; } public string Name { get; set; } = ""; public string ImageUrl { get; set; } = ""; public int StockQuantity { get; set; } public int SoldQuantity { get; set; } }
    private List<InventoryItem>? inventoryList;
    private InventoryItem? selectedProduct;
    private int addQuantity = 0;
    private bool savingStock;

    protected override async Task OnInitializedAsync() { await LoadInventory(); }

    private async Task LoadInventory()
    {
        var products = await ProductService.GetActiveProductsAsync();

        inventoryList = products.Select(p => new InventoryItem
        {
            ProductId = p.ProductId,
            Name = p.Name,
            StockQuantity = p.StockQuantity,
            ImageUrl = string.IsNullOrEmpty(p.ImageUrl) ? "https://ui-avatars.com/api/?name=SP" : p.ImageUrl,
            SoldQuantity = 0
        }).OrderBy(i => i.StockQuantity).ToList();
    }

    private void OpenAdjustModal(InventoryItem item) { selectedProduct = item; addQuantity = 1; }
    private void CloseModal() { selectedProduct = null; }

    private async Task SaveStock()
    {
        if (savingStock) return;
        if (addQuantity <= 0) { Feedback.Show("Số lượng nhập phải lớn hơn 0.", true); return; }
        if (selectedProduct != null && addQuantity > 0)
        {
            savingStock = true;
            var productId = selectedProduct.ProductId;
            var quantity = addQuantity;
            try
            {
            // Cộng dồn tồn kho qua tầng service/repository (không dùng SQL thô trong Razor).
            if (!await Feedback.RunAsync(() => ProductService.IncreaseStockAsync(productId, quantity), $"Đã nhập thêm {quantity} sản phẩm vào kho.")) return;

            selectedProduct = null;
            await LoadInventory();
            StateHasChanged();
            }
            finally { savingStock = false; }
        }
    }
}
